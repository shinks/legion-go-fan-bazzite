[Unit]
Description=Thermal fan guard (Legion Go full-speed override with hysteresis)
After=acpi-call.service
Requires=acpi-call.service

[Service]
ExecStart=/usr/local/bin/fan-guard
# Never leave the fan pinned at full speed when the guard is stopped:
ExecStop=/usr/local/bin/fan auto
Restart=always

[Install]
WantedBy=multi-user.target
